APP_NAME=UniVoice AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Set to require an X-API-Key header on /api/v1 routes. Empty = open.
API_KEY=

# STT (faster-whisper)
# Tuned for an 8 GB GPU: int8_float16 cuts large-v3 to ~2.0 GB VRAM (measured) with
# no practical accuracy loss, and greedy decoding (beam 1) is 2-3x faster
# than beam 5 on short phone utterances.
# Keep large-v3: small/medium do not recognize Uzbek. CPU-only machine:
# STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8 (slower).
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_BEAM_SIZE=1
# Parallel transcriptions; each one needs its own activation memory.
STT_MAX_CONCURRENCY=1
STT_MAX_UPLOAD_BYTES=26214400
# Uzbek fine-tune. STT_MODEL then only detects the language and transcribes
# Russian; Uzbek goes here. Downloaded from Hugging Face on first start
# (~0.74 GB, cached). Conversational Uzbek over the phone: 34.5% WER vs 73.5%
# for navai-uz and ~88% for large-v3 alone (docs/stt-evaluation.md).
# Adds ~0.8 GB VRAM. A local path works too, e.g. models/whisper-medium-uzbek-ct2
# from `make uz-model`.
STT_MODEL_UZ=ZOKHID/univoice-stt-uz-ct2
# Decoder prompts; leave the Uzbek one empty, the fine-tune continues prompts
# instead of transcribing.
STT_INITIAL_PROMPT=
STT_INITIAL_PROMPT_UZ=
# Whisper's language detector barely knows Uzbek on short phrases. Below this
# score the models' confidence in their own text picks uz/ru instead
# (Uzbek phrases: 46% -> 96% correct; docs/stt-evaluation.md).
STT_LANGUAGE_SURE=0.9
# Bring quiet phone audio to -20 dBFS before recognition.
STT_NORMALIZE_LOUDNESS=true
STT_ACCEPT_LOGPROB=-0.25
STT_MIN_LOGPROB=-1.0

# Intents below this confidence go to the operator fallback.
INTENT_MIN_CONFIDENCE=0.6

LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=30
# 0 = run the LLM on CPU and leave the GPU to Whisper.
LLM_NUM_GPU=0
# Keyword matches at or above this confidence skip the LLM entirely.
LLM_SKIP_CONFIDENCE=0.8

# TTS
# Call audio is pre-rendered once (make render-prompts) and played from
# TTS_PROMPT_CACHE_DIR, so the GPU TTS service does not run during calls.
TTS_PROVIDER=navoiy-http
TTS_BASE_URL=http://navoiy-tts:8100
TTS_TIMEOUT_SECONDS=120
TTS_PROMPT_CACHE_DIR=data/prompts

# Russian needs its own voice: Navoiy is Uzbek-only and renders Russian as
# gibberish (70-136% character error rate when transcribed back). Piper runs
# on CPU: pip install -e ".[tts-ru]" && make piper-ru
TTS_PROVIDER_RU=piper
TTS_MODEL_PATH_RU=models/piper/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx

# Piper provider settings (TTS_PROVIDER=piper or TTS_PROVIDER_RU=piper).
TTS_BINARY=piper
TTS_MODEL_PATH=

# Direct Navoiy provider settings.
# Used only when TTS_PROVIDER=navoiy.
TTS_PYTHON_BINARY=python
TTS_NAVOIY_INFERENCE_SCRIPT=
TTS_NAVOIY_COSYVOICE_DIR=
TTS_NAVOIY_BASE_MODEL_DIR=
TTS_NAVOIY_CHECKPOINT=
TTS_NAVOIY_REFERENCE_AUDIO=
TTS_NAVOIY_EMOTION=warm

# Shared generated-audio directory.
TTS_OUTPUT_DIR=/var/lib/univoice/audio

# Call log for /monitor (SQLite).
CALL_LOG_PATH=data/calls.db
CALL_LOG_RETENTION_DAYS=30
# Keep caller utterances as WAV to replay them in /monitor. Tell callers
# they are recorded before turning this on for real calls.
CALL_RECORD_AUDIO=false
CALL_AUDIO_DIR=data/calls

# Realtime telephony audio bridge
REALTIME_AUDIO_HOST=0.0.0.0
REALTIME_AUDIO_PORT=9019
REALTIME_VAD_MODE=2
REALTIME_SILENCE_MS=700
REALTIME_MIN_UTTERANCE_MS=400
REALTIME_MAX_UTTERANCE_MS=12000
# Let callers interrupt the bot by talking. Off: the greeting and every answer
# play to the end; speech during them is not heard.
REALTIME_BARGE_IN=false
# Consecutive 20 ms speech frames needed to interrupt the bot (5 = 100 ms).
REALTIME_BARGE_IN_FRAMES=5
# When the bot ends a call on its own (0 = never):
# silence after the greeting: ask once more, then goodbye and hang up;
REALTIME_NO_INPUT_SECONDS=15
# silence after an answer and "anything else?": goodbye and hang up;
REALTIME_FOLLOWUP_SECONDS=8
# longest call with the bot.
REALTIME_MAX_CALL_SECONDS=300

# Docker (docker compose). Relative paths above work in the api container too:
# ./models and ./data are mounted at /app/models and /app/data.
# Reuse Whisper models already downloaded on the host instead of a fresh 3 GB:
# HF_CACHE_DIR=C:/Users/<you>/.cache/huggingface
# Skip the ~1.2 GB CUDA wheel download by taking cuBLAS/cuDNN from a local image:
# INSTALL_GPU=0
# CUDA_LIBS_IMAGE=universal-voice-intelligence-platform-navoiy-tts
