APP_NAME=UniVoice AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MAX_UPLOAD_BYTES=26214400
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=30
TTS_BINARY=piper
TTS_MODEL_PATH=/models/uzbek.onnx

TTS_OUTPUT_DIR=/var/lib/univoice/audio
