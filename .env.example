APP_NAME=UniVoice AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Set to require an X-API-Key header on /api/v1 routes. Empty = open.
API_KEY=

# STT (faster-whisper)
# Tuned for an 8 GB GPU: int8_float16 cuts large-v3 to ~2.0 GB VRAM (measured) with
# no practical accuracy loss, and greedy decoding (beam 1) is 2-3x faster
# than beam 5 on short phone utterances.
# Keep large-v3: small/medium do not recognize Uzbek. CPU-only machine:
# STT_DEVICE=cpu, STT_COMPUTE_TYPE=int8 (slower).
STT_MODEL=large-v3
STT_DEVICE=cuda
STT_COMPUTE_TYPE=int8_float16
STT_BEAM_SIZE=1
# Parallel transcriptions; each one needs its own activation memory.
STT_MAX_CONCURRENCY=1
STT_MAX_UPLOAD_BYTES=26214400
# Uzbek fine-tune (make uz-model). STT_MODEL then only detects the language
# and transcribes Russian; Uzbek goes here. Uzbek WER over phone audio drops
# from 88% to 28% (docs/stt-evaluation.md). Adds ~0.8 GB VRAM.
# Local run: models/whisper-medium-uzbek-ct2
# After `make uz-finetune` use /models/whisper-medium-uzbek-podcasts-ct2:
# conversational Uzbek WER 73.5% -> 34.5%, read speech unchanged.
STT_MODEL_UZ=/models/whisper-medium-uzbek-ct2
# Decoder prompts; leave the Uzbek one empty, the fine-tune continues prompts
# instead of transcribing.
STT_INITIAL_PROMPT=
STT_INITIAL_PROMPT_UZ=

# Intents below this confidence go to the operator fallback.
INTENT_MIN_CONFIDENCE=0.6

LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=30
# 0 = run the LLM on CPU and leave the GPU to Whisper.
LLM_NUM_GPU=0
# Keyword matches at or above this confidence skip the LLM entirely.
LLM_SKIP_CONFIDENCE=0.8

# TTS
# Call audio is pre-rendered once (make render-prompts) and played from
# TTS_PROMPT_CACHE_DIR, so the GPU TTS service does not run during calls.
TTS_PROVIDER=navoiy-http
TTS_BASE_URL=http://navoiy-tts:8100
TTS_TIMEOUT_SECONDS=120
TTS_PROMPT_CACHE_DIR=/var/lib/univoice/audio/prompts

# Russian needs its own voice: Navoiy is Uzbek-only and renders Russian as
# gibberish (70-136% character error rate when transcribed back). Piper runs
# on CPU: pip install -e ".[tts-ru]" && make piper-ru
TTS_PROVIDER_RU=piper
TTS_MODEL_PATH_RU=/models/piper/ru/ru_RU/irina/medium/ru_RU-irina-medium.onnx

# Piper provider settings (TTS_PROVIDER=piper or TTS_PROVIDER_RU=piper).
TTS_BINARY=piper
TTS_MODEL_PATH=

# Direct Navoiy provider settings.
# Used only when TTS_PROVIDER=navoiy.
TTS_PYTHON_BINARY=python
TTS_NAVOIY_INFERENCE_SCRIPT=
TTS_NAVOIY_COSYVOICE_DIR=
TTS_NAVOIY_BASE_MODEL_DIR=
TTS_NAVOIY_CHECKPOINT=
TTS_NAVOIY_REFERENCE_AUDIO=
TTS_NAVOIY_EMOTION=warm

# Shared generated-audio directory.
TTS_OUTPUT_DIR=/var/lib/univoice/audio

# Realtime telephony audio bridge
REALTIME_AUDIO_HOST=0.0.0.0
REALTIME_AUDIO_PORT=9019
REALTIME_VAD_MODE=2
REALTIME_SILENCE_MS=700
REALTIME_MIN_UTTERANCE_MS=400
REALTIME_MAX_UTTERANCE_MS=12000
# Consecutive 20 ms speech frames needed to interrupt the bot (5 = 100 ms).
REALTIME_BARGE_IN_FRAMES=5
